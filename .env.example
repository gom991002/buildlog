# Copy this file to .env and fill in the values. Never commit .env.

# Supabase (PostgreSQL) connection URL. SQLite is not accepted.
# Supabase > Connect > Session pooler: paste the postgresql:// URI and replace [YOUR-PASSWORD]
# (remove the brackets too). If the password has @ # / : write them as %40 %23 %2F %3A.
DATABASE_URL=

# Secret used to sign login tokens (JWT). Generate your own:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=

# How long a login stays valid, in minutes (10080 = 7 days).
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# OpenAI API key for the AI summary of uploaded images/videos (plan.md section 10).
# Leave empty to turn the summary off; uploads still work without it.
OPENAI_API_KEY=
# Optional. Default: gpt-5.4-nano (low-cost model that accepts images).
# OPENAI_MODEL=gpt-5.4-nano
# Optional. Default: backend/uploads (where uploaded files are stored).
# UPLOAD_DIR=
