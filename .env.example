# Copy this file to .env and fill in the values. Never commit .env.

# Database connection URL. Relative SQLite paths are resolved from the project root.
DATABASE_URL=sqlite:///database/buildlog.sqlite3

# Secret used to sign login tokens (JWT). Generate your own:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=

# How long a login stays valid, in minutes (10080 = 7 days).
ACCESS_TOKEN_EXPIRE_MINUTES=10080
